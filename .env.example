# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsingfeed

# LLM — wybierz dostawcę: "anthropic" lub "openai"
LLM_PROVIDER=anthropic

# Klucze API (wypełnij tylko ten, którego używasz)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Model (opcjonalne — domyślnie: claude-3-5-haiku-20241022 lub gpt-4o-mini)
# LLM_MODEL=claude-3-5-haiku-20241022

# Python Worker
WORKER_POLL_INTERVAL=10
WORKER_BATCH_SIZE=5

# Node Services
COLLECTOR_PORT=3002
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
