<%- include('partials/header', {
  title: article.title + ' — PulsingFeed Quality',
  crumbs: [
    { label: 'Wydawcy', href: '/' },
    { label: article.publisher_name, href: '/publisher/' + article.publisher_id },
    { label: 'Artykuł' },
  ],
}) %>

<main class="pf-container panel-page">

  <%
    const g = scoreGrade(article.total_score);
    const status = statusBadge(article.analysis_status);
    const cats = [
      { key:'factuality',  label:'Faktyczność',              pct:'30%', score: article.factuality_score,  desc: article.factuality_description,  flags: article.llm_data?.factuality?.flags  },
      { key:'linguistic',  label:'Poprawność językowa',       pct:'20%', score: article.linguistic_score,  desc: article.linguistic_description  },
      { key:'logic',       label:'Logika i spójność',         pct:'20%', score: article.logic_score,       desc: article.logic_description,       flags: article.llm_data?.logic?.flags       },
      { key:'journalism',  label:'Standardy dziennikarskie',  pct:'20%', score: article.journalism_score,  desc: article.journalism_description,  flags: article.llm_data?.journalism?.flags  },
      { key:'sources',     label:'Rzetelność źródeł',         pct:'10%', score: article.sources_score,     desc: article.sources_description     },
    ];
  %>

  <!-- ── Nagłówek artykułu ─────────────────────────────────────────── -->
  <section class="pf-card">
    <div class="score-header">
      <div class="pf-score-ring pf-grade-<%= g %>">
        <span class="pf-score-ring__value"><%= article.total_score !== null ? article.total_score : '—' %></span>
        <span class="pf-score-ring__label">/ 100</span>
      </div>
      <div class="score-header__info">
        <h1 class="pf-type-h3"><%= article.title %></h1>
        <div class="pf-meta">
          <span><%= article.publisher_name %></span>
          <span><%= fmtDate(article.published_at || article.collected_at) %></span>
          <% if (article.url) { %>
            <span><a class="pf-link" href="<%= article.url %>" target="_blank">Otwórz artykuł ↗</a></span>
          <% } %>
        </div>
      </div>
    </div>
    <% if (article.overall_description) { %>
      <%- include('partials/alert', { alertTitle: 'Ocena ogólna', text: article.overall_description }) %>
    <% } %>
  </section>

  <!-- ── Wyniki kategorii ─────────────────────────────────────────── -->
  <section class="pf-card">
    <h2 class="pf-card__title">Oceny kategorii</h2>

    <div class="detail-list">
      <% cats.forEach(cat => { %>
      <div class="detail-section">
        <%- include('partials/meter', { value: cat.score, label: cat.label + ' (' + cat.pct + ')' }) %>

        <% if (cat.desc) { %>
          <%- include('partials/alert', { text: cat.desc }) %>
        <% } %>

        <% if (cat.flags && Object.keys(cat.flags).length > 0) { %>
        <div class="flag-row">
          <% Object.entries(cat.flags).forEach(([k, v]) => { %>
          <span class="pf-badge <%= v ? 'pf-badge--success' : 'pf-badge--error' %>">
            <%= k.replace(/_/g,' ') %>: <%= v ? '✓ tak' : '✗ nie' %>
          </span>
          <% }) %>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>
  </section>

  <!-- ── Szczegóły deterministyczne ──────────────────────────────── -->
  <% if (article.deterministic_data) { %>
  <section class="pf-card">
    <details class="panel-details">
      <summary>Szczegóły analizy deterministycznej</summary>
      <%
        const det = article.deterministic_data;
        const detRows = [
          ['Słów w artykule',             det.structure?.word_count],
          ['Akapitów',                    det.structure?.paragraph_count],
          ['Śr. długość zdania (słów)',   det.linguistic?.avg_sentence_length],
          ['Błędy językowe / 1 000 słów', det.linguistic?.errors_per_1000_words],
          ['Błędy ortograficzne',         det.linguistic?.spelling_errors],
          ['Błędy gramatyczne',           det.linguistic?.grammar_errors],
          ['Linki zewnętrzne',            det.sources?.url_count],
          ['Cytaty bezpośrednie',         det.sources?.quote_count],
          ['Atrybucje',                   det.sources?.attribution_count],
          ['Słowa sensacyjne',            det.sensationalism?.sensational_word_count],
          ['Wykrzykniki',                 det.sensationalism?.exclamation_count],
          ['Wzorce clickbait',            det.sensationalism?.clickbait_patterns],
        ];
      %>
      <div class="pf-table-wrap">
        <table class="pf-table">
          <tbody>
            <% detRows.forEach(([label, val]) => { %>
            <tr>
              <td class="kv-key"><%= label %></td>
              <td><strong><%= val !== null && val !== undefined ? val : '—' %></strong></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (det.sensationalism?.sensational_words?.length > 0) { %>
      <p class="muted sensational-title">Wykryte słowa sensacyjne:</p>
      <div class="flag-row">
        <% det.sensationalism.sensational_words.forEach(w => { %>
        <span class="pf-badge pf-badge--error"><%= w %></span>
        <% }) %>
      </div>
      <% } %>
    </details>
  </section>
  <% } %>

  <!-- ── Metadane analizy ─────────────────────────────────────────── -->
  <section class="pf-card">
    <details class="panel-details">
      <summary>Metadane analizy</summary>
      <div class="pf-table-wrap">
        <table class="pf-table">
          <tbody>
            <tr><td class="kv-key">Model LLM</td><td><%= article.llm_model || '—' %></td></tr>
            <tr><td class="kv-key">Wersja algorytmu</td><td><%= article.analysis_version || '—' %></td></tr>
            <tr><td class="kv-key">Data analizy</td><td><%= fmtDate(article.analyzed_at) %></td></tr>
            <tr><td class="kv-key">Status</td>
              <td><span class="pf-badge <%= status.cls %>"><%= status.label %></span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>
  </section>

</main>
</body>
</html>
