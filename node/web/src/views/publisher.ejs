<%- include('partials/header', {
  title: publisher.name + ' — PulsingFeed Quality',
  crumbs: [{ label: 'Wydawcy', href: '/' }, { label: publisher.name }],
}) %>

<main class="pf-container panel-page">

  <%
    const g = scoreGrade(publisher.avg_total_score);
    const score = publisher.avg_total_score;
  %>

  <!-- ── Nagłówek wydawcy ─────────────────────────────────────────── -->
  <section class="pf-card">
    <div class="score-header">
      <div class="pf-score-ring pf-grade-<%= g %>">
        <span class="pf-score-ring__value"><%= score !== null ? score : '—' %></span>
        <span class="pf-score-ring__label">/ 100</span>
      </div>
      <div class="score-header__info">
        <h1 class="pf-type-h3"><%= publisher.name %></h1>
        <div class="pf-meta">
          <span><a class="pf-link" href="<%= publisher.rss_url %>" target="_blank">RSS ↗</a></span>
          <% if (publisher.website_url) { %>
            <span><a class="pf-link" href="<%= publisher.website_url %>" target="_blank">Strona ↗</a></span>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Statystyki ogólne ────────────────────────────────────────── -->
  <section class="pf-card">
    <h2 class="pf-card__title">Statystyki ogólne</h2>
    <div class="pf-stat-grid">
      <div class="pf-stat">
        <div class="pf-stat__value"><%= publisher.analyzed_articles %></div>
        <div class="pf-stat__label">Przeanalizowanych artykułów</div>
      </div>
      <div class="pf-stat">
        <div class="pf-stat__value"><%= publisher.total_articles %></div>
        <div class="pf-stat__label">Wszystkich artykułów</div>
      </div>
      <div class="pf-stat">
        <div class="pf-stat__value"><%= publisher.pct_high_quality !== null ? publisher.pct_high_quality + '%' : '—' %></div>
        <div class="pf-stat__label">Artykułów ≥ 70 pkt</div>
      </div>
      <div class="pf-stat">
        <div class="pf-stat__value"><%= publisher.recent_avg_score !== null ? publisher.recent_avg_score : '—' %></div>
        <div class="pf-stat__label">Śr. wynik (ostatnie 30)</div>
      </div>
    </div>
  </section>

  <!-- ── Wyniki kategorii ─────────────────────────────────────────── -->
  <% if (score !== null) { %>
  <section class="pf-card">
    <h2 class="pf-card__title">Wyniki kategorii (średnie)</h2>

    <%
      const cats = [
        { label: 'Faktyczność (30%)',           val: publisher.avg_factuality },
        { label: 'Poprawność językowa (20%)',    val: publisher.avg_linguistic },
        { label: 'Logika i spójność (20%)',      val: publisher.avg_logic      },
        { label: 'Standardy dziennikarskie (20%)', val: publisher.avg_journalism },
        { label: 'Rzetelność źródeł (10%)',      val: publisher.avg_sources    },
      ];
    %>

    <% cats.forEach(cat => { %>
      <%- include('partials/meter', { value: cat.val, label: cat.label }) %>
    <% }) %>
  </section>
  <% } %>

  <!-- ── Rozkład wyników ──────────────────────────────────────────── -->
  <% if (publisher.score_distribution && publisher.score_distribution.length > 0) { %>
  <section class="pf-card">
    <h2 class="pf-card__title">Rozkład wyników artykułów</h2>
    <%
      const maxCount = Math.max(...publisher.score_distribution.map(b => parseInt(b.count)));
      const histSummary = publisher.score_distribution.map(b => `${b.label}: ${b.count}`).join(', ');
    %>
    <div class="hist-scroll">
      <div class="pf-histogram hist-chart" role="img" aria-label="Liczba artykułów w przedziałach wyniku. <%= histSummary %>">
        <% publisher.score_distribution.forEach(bucket => {
          const h = maxCount > 0 ? (parseInt(bucket.count) / maxCount * 100) : 0;
        %>
        <div class="pf-histogram__col">
          <div class="hist-plot">
            <div class="pf-histogram__bar" style="height:<%= h %>%" title="<%= bucket.label %>: <%= bucket.count %>">
              <span class="hist-count"><%= bucket.count %></span>
            </div>
          </div>
          <span class="pf-histogram__label"><%= bucket.label %></span>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ── Artykuły ─────────────────────────────────────────────────── -->
  <% if (articles.length === 0) { %>
  <div class="pf-empty">
    <p>Brak artykułów do wyświetlenia. Kolektor sprawdza kanały co 15 minut, więc wróć tu po najbliższym przebiegu.</p>
  </div>
  <% } else { %>
  <section class="pf-card pf-card--flush">
    <h2 class="pf-card__title card-heading">Artykuły (<%= articles.length %> najnowszych)</h2>
    <div class="pf-table-wrap">
      <table class="pf-table">
        <thead>
          <tr>
            <th>Artykuł</th>
            <th>Wynik</th>
            <th class="pf-table__num">Fakt.</th>
            <th class="pf-table__num">Język.</th>
            <th class="pf-table__num">Logika</th>
            <th class="pf-table__num">Dzien.</th>
            <th class="pf-table__num">Źródła</th>
            <th class="pf-table__num">Data</th>
          </tr>
        </thead>
        <tbody>
          <% articles.forEach(a => { %>
          <tr>
            <td>
              <div class="cell-inline">
                <a class="pf-link" href="/article/<%= a.id %>"><%= a.title %></a>
                <% if (a.analysis_status !== 'done') { const s = statusBadge(a.analysis_status); %>
                  <span class="pf-badge <%= s.cls %>"><%= s.label %></span>
                <% } %>
              </div>
            </td>
            <td>
              <% if (a.total_score !== null) { %>
                <span class="pf-score pf-grade-<%= scoreGrade(a.total_score) %>"><%= a.total_score %></span>
              <% } else { %>
                <span class="pf-score pf-grade-na">—</span>
              <% } %>
            </td>
            <td class="pf-table__num"><%= a.factuality_score !== null ? a.factuality_score : '—' %></td>
            <td class="pf-table__num"><%= a.linguistic_score !== null ? a.linguistic_score : '—' %></td>
            <td class="pf-table__num"><%= a.logic_score !== null ? a.logic_score : '—' %></td>
            <td class="pf-table__num"><%= a.journalism_score !== null ? a.journalism_score : '—' %></td>
            <td class="pf-table__num"><%= a.sources_score !== null ? a.sources_score : '—' %></td>
            <td class="pf-table__num nowrap muted"><%= fmtDate(a.collected_at) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <% } %>

</main>
</body>
</html>
