<%- include('partials/header', { title: 'PulsingFeed Quality — Wydawcy' }) %>

<main class="pf-container panel-page">
  <header class="pf-page-header">
    <h1 class="pf-page-header__title">Rankingi wydawców</h1>
  </header>

  <% if (!publishers || publishers.length === 0) { %>
    <div class="pf-empty">
      <p>Brak wydawców. Dodaj pierwszy kanał RSS przez API:</p>
      <code class="empty-code">POST /api/publishers { "name": "...", "rss_url": "..." }</code>
    </div>
  <% } else { %>
  <%
    const meterCols = [
      { key: 'avg_factuality', label: 'Faktyczność' },
      { key: 'avg_linguistic', label: 'Językowa' },
      { key: 'avg_logic',      label: 'Logika' },
      { key: 'avg_journalism', label: 'Dziennikarstwo' },
    ];
  %>
  <div class="pf-card pf-card--flush">
    <div class="pf-table-wrap">
      <table class="pf-table">
        <thead>
          <tr>
            <th>Wydawca</th>
            <th>Wynik ogólny</th>
            <% meterCols.forEach(col => { %><th><%= col.label %></th><% }) %>
            <th class="pf-table__num">Artykuły</th>
            <th class="pf-table__num">Ostatni artykuł</th>
          </tr>
        </thead>
        <tbody>
          <% publishers.forEach(p => { %>
          <tr>
            <td>
              <a class="pf-link" href="/publisher/<%= p.publisher_id %>"><%= p.name %></a>
              <% if (p.website_url) { %>
                <div class="muted"><%= p.website_url %></div>
              <% } %>
            </td>
            <td>
              <% if (p.avg_total_score !== null) { %>
                <span class="pf-score pf-grade-<%= scoreGrade(p.avg_total_score) %>"><%= p.avg_total_score %> / 100</span>
              <% } else { %>
                <span class="pf-score pf-grade-na">Brak danych</span>
              <% } %>
            </td>
            <% meterCols.forEach(col => { %>
            <td>
              <% if (p[col.key] !== null) { %>
                <%- include('partials/meter', { value: p[col.key], ariaLabel: col.label + ': ' + p.name }) %>
              <% } else { %>—<% } %>
            </td>
            <% }) %>
            <td class="pf-table__num">
              <strong><%= p.analyzed_articles %></strong>
              <span class="muted"> / <%= p.total_articles %></span>
            </td>
            <td class="pf-table__num nowrap muted"><%= fmtDate(p.last_article_at) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</main>

</body>
</html>
